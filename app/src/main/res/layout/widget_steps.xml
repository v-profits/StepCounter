<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет 2x2: повторяет карточку с кольцом на вкладке «Сегодня».
     Кольцо (картинка) — на всю площадь, по центру колонка: значок шагов, число шагов, «из N шагов».
     Размеры шрифтов и значка задаёт StepWidgetProvider в тех же пропорциях, что в приложении. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Кольцо прогресса; квадратная картинка вписывается по центру без искажений -->
    <ImageView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <!-- Содержимое внутри кольца -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Значок шагов (картинку нужного размера подставляет StepWidgetProvider) -->
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null" />

        <!-- Число шагов (жирным, размер задаётся из кода) -->
        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/widget_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- «из 10 000 шагов» -->
        <TextView
            android:id="@+id/widget_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/placeholder_goal"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8sp" />
    </LinearLayout>
</FrameLayout>
