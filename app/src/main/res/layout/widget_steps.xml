<?xml version="1.0" encoding="utf-8"?>
<!-- Внешний вид виджета: кольцо (картинка) и два текста поверх него -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Кольцо прогресса; саму картинку подставляет StepWidgetProvider -->
    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <!-- Текст в центре кольца -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="26dp">

        <!-- Число шагов; размер шрифта подбирается автоматически под ширину -->
        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/widget_text"
            android:textStyle="bold" />

        <!-- «из 10 000» -->
        <TextView
            android:id="@+id/widget_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:maxLines="1"
            android:text="из 10 000"
            android:textColor="@color/widget_text_secondary" />
    </LinearLayout>
</FrameLayout>
