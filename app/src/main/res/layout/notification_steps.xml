<?xml version="1.0" encoding="utf-8"?>
<!-- Содержимое уведомления в шторке: шаги, калории, дистанция (иконка + значение) и полоска прогресса -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="3">

        <!-- Шаги -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_steps_color" />

            <TextView
                android:id="@+id/notif_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="0"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Калории -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_fire_color" />

            <TextView
                android:id="@+id/notif_kcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="0 ккал"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Дистанция -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_place_color" />

            <TextView
                android:id="@+id/notif_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="0 км"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Линия прогресса к дневной цели под надписями (картинку рисует StepService) -->
    <ImageView
        android:id="@+id/notif_progress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@null"
        android:scaleType="fitXY" />
</LinearLayout>
